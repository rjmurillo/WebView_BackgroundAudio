<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <CsWinRTComponent>true</CsWinRTComponent>
    <IsAotCompatible>true</IsAotCompatible>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <RootNamespace>BackgroundAudioWinRT</RootNamespace>
    <AssemblyName>BackgroundAudioWinRT</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);NETFX_CORE;WINDOWS_UWP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>
</Project>
